---
/**
 * Le bloc d'actualité de la page d'accueil — veille promue ET publications éditoriales, un seul fil.
 *
 * IL TOMBE VERS LE VIDE. `actualiteFeed` ne rend plus rien dès que plus aucune entrée n'a moins de
 * 21 jours ; ce composant ne rend alors RIEN DU TOUT. Il ne doit jamais imprimer « rien de récent » :
 * sur la page la plus vue du site, une absence est honnête, une phrase est une affirmation — et une
 * affirmation est ce qui se met à mentir quand plus personne ne l'alimente.
 *
 * LE LIEN VERS /veille EST UNE PROP, PAS UNE CONSTANTE. La page /veille quitte entièrement le build
 * quand le magasin de promotions est vide (voir `pages/veille/[...page].astro`), or ce fil peut être
 * plein sans une seule promotion — une note fraîche y suffit. Coder le lien en dur reviendrait donc
 * à livrer un 404 depuis la page d'accueil. L'appelant le garde avec `veilleIsPublic()`.
 *
 * Forme : une liste réglée, pas une grille. Le fil a une longueur variable (1 à 4) et une grille de
 * trois colonnes y laisserait des trous. C'est un journal de bord d'état-major, pas une une de
 * quotidien : ce qui accroche l'œil est la DATE en accent en tête de chaque ligne.
 */
import Pill from './Pill.astro';
import { actualiteKindLabel, type ActualiteEntry } from '../lib/actualite';

interface Props {
  entries: ActualiteEntry[];
  /** `/veille` quand la page existe dans le build, sinon rien. Voir `veilleIsPublic()`. */
  veilleHref?: string;
}
const { entries, veilleHref } = Astro.props;
const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long' });
---

{
  entries.length > 0 && (
    <section class="border-b border-b-line border-t-2 border-t-accent bg-subtle">
      <div class="mx-auto max-w-content px-5 py-9">
        <div class="section-rule">
          {/* `.label` est en @layer components : il l'emporte sur les styles h2 de @layer base. */}
          <h2 class="label">Actualité</h2>
          {veilleHref ? (
            <a
              href={veilleHref}
              class="ml-auto font-mono text-[11px] uppercase tracking-[0.08em] text-muted hover:text-accent"
            >
              Toute la veille →
            </a>
          ) : null}
        </div>
        <ul class="divide-y divide-line">
          {entries.map((e) => (
            <li class="py-3 first:pt-0 last:pb-0">
              <a href={e.href} class="group block">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-accent">
                    {dateFmt.format(e.at)}
                  </span>
                  <Pill tone={e.kind === 'veille' ? 'accent' : 'neutral'}>
                    {actualiteKindLabel[e.kind]}
                  </Pill>
                </div>
                <p class="mt-1 font-serif text-[1.05rem] font-semibold leading-snug text-ink group-hover:text-accent">
                  {e.title}
                </p>
                {/* La phrase du promoteur pour la veille, le résumé de l'auteur pour une
                    publication — jamais la prose du modèle (ADR 0074), écartée par l'adaptateur. */}
                <p class="mt-0.5 line-clamp-2 text-sm leading-relaxed text-muted">{e.line}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
