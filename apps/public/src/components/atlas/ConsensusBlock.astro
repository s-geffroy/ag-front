---
import Pill from '../Pill.astro';
import {
  CONSENSUS_ATTRIBUTION,
  CONSENSUS_FAMILY_LABELS,
  CONSENSUS_RELIABILITY,
  type AtlasConsensus,
} from '../../lib/atlas-data';

// Derived Polymarket consensus, public-safe (ADR 0071). Renders ONLY the per-family aggregate — never a
// raw market question, individual odds, or a "proposed action". A prediction market is crowd
// ANTICIPATION, never event evidence: framed here as a candidate, capped at attention (ADR 0042).
//
// Attribution + S5 disclaimer are NOT decoration: ag-back's handoff 0018 makes them the condition of
// redistribution (`polymarket_gamma` = `cleared_with_attribution`). Both are rendered unconditionally,
// inside the same block as the figures, so the credit can never drift away from what it licenses.
// Which families and which cardinalities reach this component is decided upstream, in
// `loadCorridorConsensus` (ADR 0072). There is no longer a corridor allowlist above it — ag-back's
// `0026` §3 lifted that condition, and the perimeter is now the floors themselves. This component
// renders, it does not filter.

interface Props {
  consensus: AtlasConsensus;
}
const { consensus } = Astro.props;

/** 0..1 → "12,4 %"; guards tiny values so 0.0005 reads "< 0,1 %" rather than "0,1 %". */
function pct(p: number): string {
  const v = p * 100;
  if (v > 0 && v < 0.1) return '< 0,1 %';
  return `${v.toFixed(1).replace('.', ',')} %`;
}
/** 24h move in points, signed. Omitted by the caller when absent. */
function delta(change: number): string {
  const v = change * 100;
  const sign = v > 0 ? '+' : v < 0 ? '−' : '';
  return `${sign}${Math.abs(v).toFixed(1).replace('.', ',')} pt/24 h`;
}
function observedLabel(iso?: string): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}
const observed = observedLabel(consensus.observedAt);
// Highest-probability family first — most salient anticipation on top.
const families = [...consensus.families].sort((a, b) => b.probability - a.probability);
---

<section>
  <div class="section-rule">
    <span class="label">Consensus de marché</span>
    <Pill tone="risk" class="ml-2">{CONSENSUS_RELIABILITY.label}</Pill>
  </div>
  <p class="mb-3 text-xs text-muted">
    Probabilité de consensus des marchés de prédiction <strong>{CONSENSUS_ATTRIBUTION.source}</strong>,
    pondérée par la liquidité et agrégée par famille de signal. Le nombre de marchés indique une
    pluralité de cotations, <strong>pas leur indépendance</strong> : deux marchés proches du même auteur
    y comptent pour deux. {CONSENSUS_RELIABILITY.text}
  </p>
  <ul class="space-y-2.5 text-sm">
    {
      families.map((f) => (
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="font-medium">{CONSENSUS_FAMILY_LABELS[f.signalFamily]}</span>
          <span class="font-mono tabular-nums text-accent">{pct(f.probability)}</span>
          {f.change24h != null && f.change24h !== 0 ? (
            <span class="font-mono text-[11px] text-muted">{delta(f.change24h)}</span>
          ) : null}
          {f.marketCount != null ? (
            <span class="font-mono text-[11px] text-muted">
              · {f.marketCount} marché{f.marketCount > 1 ? 's' : ''}
            </span>
          ) : null}
        </li>
      ))
    }
  </ul>
  {
    observed ? (
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
        Consensus au {observed}
      </p>
    ) : null
  }
  <p class="mt-3 border-t border-line pt-2 text-[11px] leading-relaxed text-muted">
    {CONSENSUS_ATTRIBUTION.text}{' '}
    <a
      href={CONSENSUS_ATTRIBUTION.url}
      class="underline hover:text-ink"
      rel="nofollow noopener"
      target="_blank">{CONSENSUS_ATTRIBUTION.source}</a
    >
  </p>
</section>
