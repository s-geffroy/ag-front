---
import { site } from '../lib/site';
import { navWithVeille } from '../lib/veille';
const nav = navWithVeille();
import { plaquetteIsPublic } from '../lib/plaquette';
import { publishableLegalPages } from '../lib/legal';
const year = 2026;
// Same guard as the route itself: a legal page still carrying an unfilled fact is not built, so
// linking it unconditionally would ship a 404 in the footer of every page (the plaquette lesson).
const legal = publishableLegalPages();
// Flatten dropdown groups so every method page still appears as a direct link.
const footerLinks = nav.flatMap((n) => ('children' in n ? n.children : [n]));
// The plaquette page only exists in the build once it is published (ADR 0073) — linking it before
// that would ship a 404 in the footer of every page on the site.
const showPlaquette = plaquetteIsPublic();
---

<footer class="bg-graticule mt-24 border-t-2 border-t-navy bg-surface">
  <div class="mx-auto max-w-content px-5 py-12">
    <div class="grid gap-8 md:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <div class="font-serif text-lg font-bold text-ink">Applied Geopolitics</div>
        <p class="mt-2 max-w-sm text-sm text-muted">{site.baseline}</p>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted">
          Applied Geopolitics publie. <span class="text-ink">Sylvain Geffroy</span> signe.
          <span class="text-ink">LucidAxis</span> porte structurellement.
        </p>
      </div>
      <nav class="text-sm">
        <div class="label mb-3">Explorer</div>
        <ul class="space-y-1.5">
          {footerLinks.map((n) => <li><a href={n.href} class="text-muted hover:text-ink">{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="text-sm">
        <div class="label mb-3">Contact</div>
        <ul class="space-y-1.5 text-muted">
          <li><a href="/contact" class="hover:text-ink">Demander un échange</a></li>
          {/* Deliberately here and not in `nav`: Footer flattens `nav`, so adding it there would put
              the plaquette in the header menu too, which already carries six entries. */}
          {showPlaquette && <li><a href="/plaquette" class="hover:text-ink">Plaquette (PDF)</a></li>}
          <li><a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a></li>
          <li><a href="/notes/rss.xml" class="hover:text-ink">Flux RSS des notes</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-line pt-6 text-xs leading-relaxed text-muted">
      <p>
        Applied Geopolitics fournit des analyses structurées, des scénarios, des seuils et des
        niveaux de confiance. Elle ne fournit pas de garantie de prédiction, ni de conseil juridique,
        financier ou assurantiel engageant, et ne se substitue pas à la décision interne du client.
        La géométrie des cartes est schématique, sans valeur navigationnelle ou juridique.
      </p>
      <p class="mt-3 font-mono uppercase tracking-[0.08em]">
        © {year} Applied Geopolitics — LucidAxis. Tous droits réservés.
      </p>
      {
        legal.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            {legal.map((p) => (
              <li>
                <a href={`/${p.slug}`} class="text-muted underline hover:text-ink">
                  {p.navLabel}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
