# Copy to docker/.env and adjust if your host user is not 1000:1000.
# Find yours with: id -u  /  id -g
UID=1000
GID=1000

# Public IPv4 the `public` (Caddy) service binds to — bind the public IP, not 0.0.0.0,
# to avoid colliding with the cockpit's tailscale serve on the Tailscale interface.
PUBLIC_IP=72.61.101.1

# Chokepoints Read API (Tailscale). The VPS reaches it over the tailnet.
CHOKEPOINTS_API_URL=https://srv1305127.tail880531.ts.net/api
# READ scope (clear data) — used by the PUBLIC site build (apps/public). Never tainted.
CHOKEPOINTS_API_TOKEN=
# READ_TAINTED scope — used ONLY by the internal cockpit (Tailscale). Restricted records stay internal,
# never published to the public site (ADR 0013).
CHOKEPOINTS_API_TOKEN_TAINTED=

# --- HDDE (hdde.applied-geopolitics.com) — ADR 0032/0033/0034/0035 ---
# Long random string owning sessions. Generate: openssl rand -hex 32
HDDE_SESSION_SECRET=
# OpenAI red team. Leave disabled (offline facade) until you set a key.
HDDE_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# HDDE reuses CHOKEPOINTS_API_TOKEN above (READ scope only — never the tainted token) to feed the
# interview + red team server-side. Public clients never see the token or tainted records (ADR 0035).

# --- VERDICT (verdict.applied-geopolitics.com) — ADR 0041/0042/0043 ---
# Shared service token for the HDDE→VERDICT internal ingestion API. The SAME value must be set for both
# the hdde and verdict services. Empty disables ingestion. Generate: openssl rand -hex 24
INTERNAL_API_TOKEN=
# OpenAI arbitrage red team. Leave disabled (offline facade) until you set OPENAI_API_KEY above.
# VERDICT reuses OPENAI_API_KEY / OPENAI_MODEL and CHOKEPOINTS_API_TOKEN (READ scope) shared above.
VERDICT_LLM_ENABLED=false

# --- Lead notification (POST /api/lead) — ADR 0006 / 0011 ---
# WITHOUT SMTP_HOST, apps/lead-api/server/email.ts is a no-op: the lead is still stored in
# contacts.json + leads.ndjson, but NOBODY IS NOTIFIED. For a site whose purpose is B2B prospecting
# that is a silent loss, so treat these as go-live values, not as an optional extra.
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; STARTTLS on 587 stays false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where the notification lands, and the envelope sender. The prospect's address is set as Reply-To,
# never as From — sending as them would fail SPF/DMARC at the recipient.
LEAD_TO=contact@applied-geopolitics.com
LEAD_FROM=no-reply@applied-geopolitics.com

# --- Promotion d'actualités depuis Slack (Socket Mode, ADR 0071/0074) ---
# Socket Mode : le service ouvre une WebSocket SORTANTE vers Slack. Aucun port, aucune règle Caddy,
# aucune URL publique — donc aucune surface d'attaque ajoutée.
#
# À créer une fois dans https://api.slack.com/apps :
#   1. Nouvelle app → activer Socket Mode → générer un App-Level Token (scope connections:write) → xapp-
#   2. OAuth & Permissions → bot scopes : chat:write, commands → installer → xoxb-
#   3. Interactivity & Shortcuts → activer (aucune Request URL à renseigner en Socket Mode)
#   4. Inviter le bot dans le canal PRIVÉ, puis relever son identifiant (C…) — l'autorisation, c'est lui
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Inscrit au journal nominatif sous la forme « ‹nom› (via Slack) ».
# NE PAS y mettre « (via Slack) » soi-même : validatedBy() l'ajoute (apps/slackbot/server/promote.ts),
# sinon le journal porte la mention en double, pour toujours (il est append-only).
SLACK_OPERATOR_NAME=sge
#
# PIÈGE — DEUX FICHIERS. Ce fichier-ci n'alimente que le SERVICE slackbot (compose). Le digest
# hebdomadaire, lui, tourne en cron SUR L'HÔTE et source `scripts/consumer/.env` : il faut y
# recopier SLACK_BOT_TOKEN et SLACK_CHANNEL_ID. Sans cela le digest part par le webhook, donc
# SANS boutons — le canal reste unidirectionnel et rien ne peut être validé depuis Slack.

# --- Flux d'actualités au fil de l'eau (scripts/news-stream-cron.sh) ---
# Le sondeur horaire poste lui-même dans le canal privé : il réutilise SLACK_BOT_TOKEN et
# SLACK_CHANNEL_ID ci-dessus, aucun secret nouveau. Ce plafond limite les annonces NEUVES par passe,
# pour qu'un premier sondage (registre vide) ne vide pas le flux dans le canal d'un seul coup.
# VIDE = le défaut du code (5). Un `0` ÉCRIT coupe le flux volontairement — c'est accepté.
NEWS_STREAM_MAX_PER_RUN=8
